{
  "name": "nuzlocke-overlay",
  "version": "2.0.0",
  "description": "Nuzlocke Overlay App - OBS overlay for Pokemon Nuzlocke runs with real-time team tracking",
  "main": "main.js",
  "author": "PokeJgamer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "setup": "npm install && electron-builder --win portable"
  },
  "build": {
    "appId": "com.nuzlocke.overlay",
    "productName": "Nuzlocke Overlay",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "logo.png",
      "src/**/*",
      "app/**/*",
      "public/**/*",
      "!node_modules/.cache",
      "!Recursos"
    ],
    "extraResources": [
      {
        "from": "PkHexReader/bin/Release/net8.0/PkHexReader.dll",
        "to": "PkHexReader.dll"
      },
      {
        "from": "PkHexReader/bin/Release/net8.0/PKHeX.Core.dll",
        "to": "PKHeX.Core.dll"
      },
      {
        "from": "PkHexReader/bin/Release/net8.0/PkHexReader.runtimeconfig.json",
        "to": "PkHexReader.runtimeconfig.json"
      },
      {
        "from": "PkHexReader/bin/Release/net8.0/PkHexReader.deps.json",
        "to": "PkHexReader.deps.json"
      }
    ],
    "win": {
      "target": "portable",
      "icon": "logo.png"
    },
    "portable": {
      "artifactName": "NuzlockeOverlay.exe"
    }
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
