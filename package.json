{
  "name": "nuzlocke-overlay",
  "version": "1.1.1-beta.1",
  "description": "Nuzlocke Overlay App - OBS overlay for Pokemon Nuzlocke runs with real-time team tracking",
  "main": "main.js",
  "author": "PokeJgamer",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --mac --linux",
    "build:win": "electron-builder --win nsis",
    "build:mac": "electron-builder --mac dir",
    "build:linux": "electron-builder --linux dir",
    "setup": "npm install && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.nuzlocke.overlay",
    "productName": "Nuzlocke Overlay",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "settings.html",
      "logo.png",
      "src/**/*",
      "app/**/*",
      "public/**/*",
      "!node_modules/.cache",
      "!Recursos"
    ],
    "extraResources": [
      {
        "from": "resources/pkhex/PkHexReader.dll",
        "to": "PkHexReader.dll"
      },
      {
        "from": "resources/pkhex/PKHeX.Core.dll",
        "to": "PKHeX.Core.dll"
      },
      {
        "from": "resources/pkhex/PkHexReader.runtimeconfig.json",
        "to": "PkHexReader.runtimeconfig.json"
      },
      {
        "from": "resources/pkhex/PkHexReader.deps.json",
        "to": "PkHexReader.deps.json"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nuzlocke Overlay",
      "installerIcon": "logo.ico",
      "uninstallerIcon": "logo.ico",
      "artifactName": "NuzlockeOverlay-Setup-${version}.exe",
      "include": "build/installer.nsh"
    },
    "mac": {
      "target": "dir",
      "icon": "logo.png",
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "dir",
      "icon": "logo.png",
      "category": "Game"
    }
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "express": "^4.21.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  }
}
